    <!-- ===== Shared component styles (read the tokens above) ===== -->
    <style name="ObdSectionTitle">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">?attr/obdTextSecondary</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:fontFamily">?attr/obdTitleFont</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="ObdCard" parent="Widget.Material3.CardView.Filled">
