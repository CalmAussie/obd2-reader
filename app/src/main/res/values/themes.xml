    <!-- ===== Card shapes per theme ===== -->
    <style name="ShapeAppearance.Obd.Midnight" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>
    <style name="ShapeAppearance.Obd.Racing" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">6dp</item>
    </style>
    <style name="ShapeAppearance.Obd.Daylight" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>
    <style name="ShapeAppearance.Obd.Lcd" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">4dp</item>
    </style>
    <!-- Big cuts on opposite corners give the angular, sporty silhouette. -->
    <style name="ShapeAppearance.Obd.Apex" parent="">
        <item name="cornerFamily">cut</item>
        <item name="cornerSizeTopLeft">18dp</item>
        <item name="cornerSizeBottomRight">18dp</item>
        <item name="cornerSizeTopRight">3dp</item>
        <item name="cornerSizeBottomLeft">3dp</item>
    </style>
    <style name="ShapeAppearance.Obd.Cut.4" parent="">
        <item name="cornerFamily">cut</item>
        <item name="cornerSize">4dp</item>
    </style>
    <style name="ShapeAppearance.Obd.Cut.8" parent="">
        <item name="cornerFamily">cut</item>
        <item name="cornerSize">8dp</item>
    </style>
    <style name="ShapeAppearance.Obd.Cut.12" parent="">
        <item name="cornerFamily">cut</item>
        <item name="cornerSize">12dp</item>
    </style>
    <style name="ShapeAppearance.Obd.Cut.16" parent="">
        <item name="cornerFamily">cut</item>
        <item name="cornerSize">16dp</item>
