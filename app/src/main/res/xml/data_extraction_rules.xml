<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: the same rules for cloud backup and for moving to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="logs/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="logs/" />
    </device-transfer>
</data-extraction-rules>
