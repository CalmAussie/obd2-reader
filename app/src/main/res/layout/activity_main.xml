<?xml version="1.0" encoding="utf-8"?>
<!-- Two pages (Dashboard and Diagnostics) above a bottom bar. The Dashboard holds all three
     layouts (livery, telemetry and cockpit); MainActivity shows the one the chosen style uses. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/obdBg"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ===================== Dashboard ===================== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/pageDashboard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.obdreader.app.ui.LiveryStripesView
                    android:id="@+id/stripesDash"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <LinearLayout
                    android:id="@+id/content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingBottom="28dp">

                    <LinearLayout
                        android:id="@+id/topBar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="12dp">

                        <TextView
                            android:id="@+id/titleDashboard"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="?attr/obdTitleFont"
                            android:text="@string/app_name"
                            android:textColor="?attr/obdTextPrimary"
                            android:textSize="22sp" />

                        <ImageButton
                            android:id="@+id/themeButton"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/appearance"
                            android:src="@drawable/ic_palette"
                            app:tint="?attr/obdTextSecondary" />
                    </LinearLayout>

                    <!-- Livery: race-number roundel, start lights and decals -->
                    <LinearLayout
                        android:id="@+id/layoutLivery"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <com.obdreader.app.ui.RoundelView
                            android:id="@+id/rpmRoundel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp" />

                        <com.obdreader.app.ui.StartLightsView
                            android:id="@+id/startLights"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp" />

                        <FrameLayout
                            android:id="@+id/decalSpeed"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:id="@+id/decalCoolant"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="5dp"
                                android:layout_weight="1" />

                            <FrameLayout
                                android:id="@+id/decalFuel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:layout_weight="1" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Race telemetry: shift lights, big numbers and a 30-second trace -->
                    <LinearLayout
                        android:id="@+id/layoutTelemetry"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <com.obdreader.app.ui.ShiftLightsView
                            android:id="@+id/shiftLights"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:orientation="horizontal">

                            <View
                                android:id="@+id/teleRpmBar"
                                android:layout_width="3dp"
                                android:layout_height="match_parent" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.25"
                                android:orientation="vertical"
                                android:paddingStart="12dp">

                                <TextView style="@style/ObdSectionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/engine_speed" android:textSize="12sp" />
                                <TextView
                                    android:id="@+id/teleRpm"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="?attr/obdTitleFont"
                                    android:fontFeatureSettings="tnum"
                                    android:includeFontPadding="false"
                                    android:text="@string/dash"
                                    android:textColor="?attr/obdTextPrimary"
                                    android:textSize="66sp" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/unit_rpm" android:textColor="?attr/obdTextSecondary" android:textSize="13sp" />
                            </LinearLayout>

                            <View
                                android:id="@+id/teleSpeedBar"
                                android:layout_width="3dp"
                                android:layout_height="match_parent"
                                android:layout_marginStart="12dp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:paddingStart="12dp">

                                <TextView style="@style/ObdSectionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/speed" android:textSize="12sp" />
                                <TextView
                                    android:id="@+id/teleSpeed"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="?attr/obdTitleFont"
                                    android:fontFeatureSettings="tnum"
                                    android:includeFontPadding="false"
                                    android:text="@string/dash"
                                    android:textColor="?attr/obdTextPrimary"
                                    android:textSize="66sp" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/unit_kmh" android:textColor="?attr/obdTextSecondary" android:textSize="13sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/telePanel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <com.obdreader.app.ui.TraceView
                                android:id="@+id/teleTrace"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />

                            <TextView
                                android:id="@+id/teleLegend"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:textColor="?attr/obdTextSecondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/teleCoolant"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="4dp"
                                android:layout_weight="1"
                                android:padding="12dp"
                                android:textColor="?attr/obdTextPrimary"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/teleFuel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:layout_weight="1"
                                android:padding="12dp"
                                android:textColor="?attr/obdTextPrimary"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Digital cockpit: glowing ring and glass panels -->
                    <LinearLayout
                        android:id="@+id/layoutCockpit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <com.obdreader.app.ui.CockpitRingView
                            android:id="@+id/cockpitRing"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" />

                        <LinearLayout
                            android:id="@+id/glassRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="horizontal" />
                    </LinearLayout>

                    <!-- Connect, shared by every layout -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:orientation="horizontal">

                        <com.obdreader.app.ui.SkewButton
                            android:id="@+id/connectButton"
                            android:layout_width="0dp"
                            android:layout_height="58dp"
                            android:layout_weight="1" />

                        <com.obdreader.app.ui.SkewButton
                            android:id="@+id/demoButton"
                            android:layout_width="wrap_content"
                            android:layout_height="58dp"
                            android:layout_marginStart="10dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/statusText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/not_connected"
                        android:textColor="?attr/obdTextPrimary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/statusDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="?attr/obdTextSecondary"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chooseCarButton"
                        style="@style/Widget.Material3.Button.TextButton.Icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="-12dp"
                        android:text="@string/choose_car"
                        android:textColor="?attr/obdAccent"
                        android:visibility="gone"
                        app:icon="@drawable/ic_search"
                        app:iconTint="?attr/obdAccent" />

                    <TextView
                        style="@style/ObdHeading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:layout_marginBottom="10dp"
                        android:text="@string/live_data" />

                    <LinearLayout
                        android:id="@+id/gaugeGrid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </FrameLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ===================== Diagnostics ===================== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/pageDiagnostics"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.obdreader.app.ui.LiveryStripesView
                    android:id="@+id/stripesDiag"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <LinearLayout
                    android:id="@+id/contentDiag"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingBottom="28dp">

                    <TextView
                        android:id="@+id/titleDiagnostics"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingTop="12dp"
                        android:fontFamily="?attr/obdTitleFont"
                        android:text="@string/nav_diagnostics"
                        android:textColor="?attr/obdTextPrimary"
                        android:textSize="30sp" />

                    <TextView
                        android:id="@+id/statusText2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/not_connected"
                        android:textColor="?attr/obdTextSecondary"
                        android:textSize="14sp" />

                    <com.obdreader.app.ui.MilBannerView
                        android:id="@+id/milBanner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="16dp"
                        android:paddingStart="22dp"
                        android:paddingEnd="18dp">

                        <ImageView
                            android:id="@+id/milLamp"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_lamp_engine" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/dtcStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="?attr/obdTitleFont"
                                android:text="@string/engine_not_checked"
                                android:textSize="19sp" />

                            <TextView
                                android:id="@+id/dtcSub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="@string/dtc_hint"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </com.obdreader.app.ui.MilBannerView>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <com.obdreader.app.ui.SkewButton
                            android:id="@+id/readDtcButton"
                            android:layout_width="0dp"
                            android:layout_height="50dp"
                            android:layout_marginEnd="5dp"
                            android:layout_weight="1" />

                        <com.obdreader.app.ui.SkewButton
                            android:id="@+id/clearDtcButton"
                            android:layout_width="0dp"
                            android:layout_height="50dp"
                            android:layout_marginStart="5dp"
                            android:layout_weight="1" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/dtcContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical" />

                    <TextView
                        style="@style/ObdHeading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:layout_marginBottom="10dp"
                        android:text="@string/vehicle" />

                    <com.obdreader.app.ui.VinDecalView
                        android:id="@+id/vinDecal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="18dp"
                        android:paddingVertical="14dp">

                        <TextView
                            android:id="@+id/vinLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/archivo_semibold"
                            android:text="@string/vin"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/vinText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="44dp"
                            android:layout_marginTop="4dp"
                            android:fontFamily="?attr/obdTitleFont"
                            android:maxLines="1"
                            android:text="@string/dash"
                            android:textIsSelectable="true"
                            android:textSize="16sp" />
                    </com.obdreader.app.ui.VinDecalView>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/vehicleText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/archivo_medium"
                                android:text="@string/vehicle_unknown"
                                android:textColor="?attr/obdTextPrimary"
                                android:textSize="15sp" />

                            <TextView
                                android:id="@+id/protocolText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="@string/protocol_unknown"
                                android:textColor="?attr/obdTextSecondary"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/vinButton"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/read_vin"
                            android:textColor="?attr/obdAccent" />
                    </LinearLayout>

                    <TextView
                        style="@style/ObdHeading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:layout_marginBottom="10dp"
                        android:text="@string/connection" />

                    <LinearLayout
                        android:id="@+id/carRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/archivo_medium" android:text="@string/your_car" android:textColor="?attr/obdTextPrimary" android:textSize="15sp" />

                            <TextView
                                android:id="@+id/carSetting"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:gravity="end"
                                android:maxLines="1"
                                android:text="@string/car_not_set"
                                android:textColor="?attr/obdAccent"
                                android:textSize="14sp" />

                            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_marginStart="4dp" android:importantForAccessibility="no" android:src="@drawable/ic_chevron_right" app:tint="?attr/obdTextSecondary" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/carHelp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/car_help"
                            android:textColor="?attr/obdTextSecondary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/protocolRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/archivo_medium" android:text="@string/protocol" android:textColor="?attr/obdTextPrimary" android:textSize="15sp" />

                            <TextView
                                android:id="@+id/protocolSetting"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:gravity="end"
                                android:maxLines="1"
                                android:text="@string/protocol_auto"
                                android:textColor="?attr/obdAccent"
                                android:textSize="14sp" />

                            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_marginStart="4dp" android:importantForAccessibility="no" android:src="@drawable/ic_chevron_right" app:tint="?attr/obdTextSecondary" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/protocol_help"
                            android:textColor="?attr/obdTextSecondary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/logCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="@font/archivo_medium" android:text="@string/adapter_log" android:textColor="?attr/obdTextPrimary" android:textSize="15sp" />

                            <TextView
                                android:id="@+id/logToggle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/show"
                                android:textColor="?attr/obdAccent"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/logText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="monospace"
                            android:textColor="?attr/obdTextSecondary"
                            android:textIsSelectable="true"
                            android:textSize="11sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/helpRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/archivo_medium" android:text="@string/help" android:textColor="?attr/obdTextPrimary" android:textSize="15sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/help_row_sub"
                                android:textColor="?attr/obdTextSecondary"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_marginStart="8dp" android:importantForAccessibility="no" android:src="@drawable/ic_chevron_right" app:tint="?attr/obdTextSecondary" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/obdSurface"
        app:itemActiveIndicatorStyle="@style/ObdNavIndicator"
        app:itemIconTint="@color/nav_item"
        app:itemTextColor="@color/nav_item"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav" />
</LinearLayout>
