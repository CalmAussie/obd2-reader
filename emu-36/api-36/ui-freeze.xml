d="false" selected="false" bounds="[42,0][1038,2190]" drawing-order="6" hint=""><node index="0" text="" resource-id="" class="android.widget.LinearLayout" package="com.obdreader.app" content-desc="P0133, Oxygen sensor slow response (bank 1, sensor 1). Tap to hide details" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[42,0][1038,2133]" drawing-order="1" hint=""><node index="1" text="" resource-id="" class="android.widget.LinearLayout" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[78,0][1002,2097]" drawing-order="2" hint=""><node index="1" text="The car is usually safe to drive for now, but fuel use, emissions or performance may suffer. Get it checked in the next few weeks." resource-id="" class="android.widget.TextView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[78,0][1002,82]" drawing-order="2" hint="" /><node index="2" text="What it means" resource-id="" class="android.widget.TextView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[78,82][1002,174]" drawing-order="3" hint="" /><node index="3" text="The front oxygen sensor (before the catalytic converter), which the computer uses to set the fuel mixture, is reacting too slowly to changes in the exhaust. It's usually an ageing sensor." resource-id="" class="android.widget.TextView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[78,174][1002,383]" drawing-order="4" hint="" /><node index="4" text="You might notice" resource-id="" class="android.widget.TextView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[78,383][1002,475]" drawing-order="5" hint="" /><node index="5" text="•  Higher fuel use&#10;•  Can lead to a catalytic converter code if ignored" resource-id="" class="android.widget.TextView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[78,475][1002,592]" drawing-order="6" hint="" /><node index="6" text="Common causes" resource-id="" class="android.widget.TextView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[78,592][1002,684]" drawing-order="7" hint="" /><node index="7" text="•  An old, worn-out oxygen sensor (common after 150,000 km)&#10;•  A sensor contaminated by oil burning or a coolant leak&#10;•  An exhaust leak near the sensor" resource-id="" class="android.widget.TextView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[78,684][1002,893]" drawing-order="8" hint="" /><node index="8" text="What to check" resource-id="" class="android.widget.TextView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[78,893][1002,985]" drawing-order="9" hint="" /><node index="9" text="1.  Check for exhaust leaks near the sensor&#10;2.  Check the engine isn't burning oil or coolant&#10;3.  Replace the sensor" resource-id="" class="android.widget.TextView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[78,985][1002,1148]" drawing-order="10" hint="" /><node index="10" text="When it was set (freeze frame)" resource-id="" class="android.widget.TextView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[78,1148][1002,1240]" drawing-order="11" hint="" /><node index="11" text="Fuel system: Closed loop, using the oxygen sensors (normal)&#10;Engine RPM: 2,140 rpm&#10;Speed: 40 mph&#10;Coolant: 190 °F&#10;Engine load: 41%&#10;Short-term fuel trim (bank 1): +9.4%&#10;Long-term fuel trim (bank 1): +12.5%&#10;Manifold pressure: 46 kPa&#10;Intake air: 84 °F&#10;Throttle: 18%&#10;MAF airflow: 12.1 g/s" resource-id="" class="android.widget.TextView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[78,1240][1002,1817]" drawing-order="12" hint="" /><node index="12" text="The car's own snapshot of the engine when this code was stored. Show it to your mechanic: it says what the engine was doing when the fault happened." resource-id="" class="android.widget.TextView" package="com.