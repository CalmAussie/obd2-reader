abled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[52,1030][1028,1110]" /><node index="1" text="You're on the latest version (2.5.3). Here's what's in it:" resource-id="" class="android.widget.TextView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[52,1110][1028,1201]" /><node index="2" text="2.5.3  ·  14 November 2026" resource-id="" class="android.widget.TextView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[52,1201][1028,1317]" /><node index="3" text="• Record and replay. Under Car and connection: turn on Record car replies, and each time you connect, what your car answers to the app's requests is saved in a plain text file on your phone. Replay it later without the car, like the demo car, or share it with a bug report. Your VIN is left out unless Hide VIN shows it in full. The newest 10 recordings are kept.&#10;• G-force. With your phone in a mount, its motion sensor shows forward and sideways g on the Dashboard and a g-meter on the Race telemetry layout. It learns how the phone sits in the mount after you drive off and brake once in a straight line; phones without a motion sensor show N/A. After a drive, the trip summary shows the peak braking, speeding up and cornering g and how many harsh moments there were (they don't change the driving scores), the drive card shows the peak g, recorded drives get g columns, and the video overlay shows a g-meter for drives recorded with it. It all stays on your phone.&#10;• Trip summary. The Driving score figures are now centred in their boxes." resource-id="" class="android.widget.TextView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[52,1317][1028,2201]" /></node></node></node></node></node></node></node></node></node><node index="1" text="" resource-id="android:id/navigationBarBackground" class="android.view.View" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" /></node></hierarchy>