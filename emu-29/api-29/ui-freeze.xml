android.widget.TextView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[408,225][930,313]" /></node><node index="2" text="" resource-id="" class="android.widget.ImageView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[945,189][1002,246]" /></node><node index="1" text="" resource-id="" class="android.widget.LinearLayout" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[78,313][1002,2127]"><node index="0" text="Check soon" resource-id="" class="android.widget.TextView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[78,344][316,416]" /><node index="1" text="The car is usually safe to drive for now, but fuel use, emissions or performance may suffer. Get it checked in the next few weeks." resource-id="" class="android.widget.TextView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[78,416][1002,579]" /><node index="2" text="What it means" resource-id="" class="android.widget.TextView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[78,579][1002,671]" /><node index="3" text="The front oxygen sensor (before the catalytic converter), which the computer uses to set the fuel mixture, is reacting too slowly to changes in the exhaust. It's usually an ageing sensor." resource-id="" class="android.widget.TextView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[78,671][1002,880]" /><node index="4" text="You might notice" resource-id="" class="android.widget.TextView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[78,880][1002,972]" /><node index="5" text="•  Higher fuel use&#10;•  Can lead to a catalytic converter code if ignored" resource-id="" class="android.widget.TextView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[78,972][1002,1089]" /><node index="6" text="Common causes" resource-id="" class="android.widget.TextView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[78,1089][1002,1181]" /><node index="7" text="•  An old, worn-out oxygen sensor (common after 150,000 km)&#10;•  A sensor contaminated by oil burning or a coolant leak&#10;•  An exhaust leak near the sensor" resource-id="" class="android.widget.TextView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[78,1181][1002,1390]" /><node index="8" text="What to check" resource-id="" class="android.widget.TextView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[78,1390][1002,1482]" /><node index="9" text="1.  Check for exhaust leaks near the sensor&#10;2.  Check the engine isn't burning oil or coolant&#10;3.  Replace the sensor" resource-id="" class="android.widget.TextView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[78,1482][1002,1645]" /><node index="10" text="When it was set (freeze frame)" resource-id="" class="android.widget.TextView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[78,1645][1002,1737]" /><node index="11" text="Fuel system: Closed loop, using the oxygen sensors (normal)&#10;Engine RPM: 2,140 rpm&#10;Speed: 40 mph&#10;Coolant: 190 °F&#10;Engine load: 41%&#10;Short-term fuel trim (bank 1): +9.4%&#10;Long-term fuel trim (bank 1): +12.5%&#10;Manifold pressure: 46 kPa&#10;Intake air: 84 °F&#10;Throttle: 18%&#10;MAF airflow: 12.1 g/s" resource-id="" class="android.widget.TextView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[78,1737][1002,2127]" /></node></node></node></node></node></node></node><node index="1" text="" resource-id="com.