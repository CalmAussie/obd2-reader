lse" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[42,0][1038,1995]"><node index="1" text="" resource-id="" class="android.widget.LinearLayout" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[78,0][1002,1959]"><node index="2" text="What it means" resource-id="" class="android.widget.TextView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[78,0][1002,36]" /><node index="3" text="The front oxygen sensor (before the catalytic converter), which the computer uses to set the fuel mixture, is reacting too slowly to changes in the exhaust. It's usually an ageing sensor." resource-id="" class="android.widget.TextView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[78,36][1002,245]" /><node index="4" text="You might notice" resource-id="" class="android.widget.TextView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[78,245][1002,337]" /><node index="5" text="•  Higher fuel use&#10;•  Can lead to a catalytic converter code if ignored" resource-id="" class="android.widget.TextView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[78,337][1002,454]" /><node index="6" text="Common causes" resource-id="" class="android.widget.TextView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[78,454][1002,546]" /><node index="7" text="•  An old, worn-out oxygen sensor (common after 150,000 km)&#10;•  A sensor contaminated by oil burning or a coolant leak&#10;•  An exhaust leak near the sensor" resource-id="" class="android.widget.TextView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[78,546][1002,755]" /><node index="8" text="What to check" resource-id="" class="android.widget.TextView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[78,755][1002,847]" /><node index="9" text="1.  Check for exhaust leaks near the sensor&#10;2.  Check the engine isn't burning oil or coolant&#10;3.  Replace the sensor" resource-id="" class="android.widget.TextView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[78,847][1002,1010]" /><node index="10" text="When it was set (freeze frame)" resource-id="" class="android.widget.TextView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[78,1010][1002,1102]" /><node index="11" text="Fuel system: Closed loop, using the oxygen sensors (normal)&#10;Engine RPM: 2,140 rpm&#10;Speed: 64 km/h&#10;Coolant: 88 °C&#10;Engine load: 41%&#10;Short-term fuel trim (bank 1): +9.4%&#10;Long-term fuel trim (bank 1): +12.5%&#10;Manifold pressure: 46 kPa&#10;Intake air: 29 °C&#10;Throttle: 18%&#10;MAF airflow: 12.1 g/s" resource-id="" class="android.widget.TextView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[78,1102][1002,1679]" /><node index="12" text="The car's own snapshot of the engine when this code was stored. Show it to your mechanic: it says what the engine was doing when the fault happened." resource-id="" class="android.widget.TextView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[78,1679][1002,1842]" /><node index="13" text="P0133: Engine and transmission (powertrain), generic code (same meaning on every car)." resource-id="" class="android.widget.TextView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[78,1842][1002,1959]" /></node></node><node index="1" text="" resource-id="" class="android.widget.LinearLayout" package="com.obdreader.app" content-desc="P0420, Catalytic converter efficiency below threshold (bank 1). Tap for details" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[42,2016][1038,2127]"><node index