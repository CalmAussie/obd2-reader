"android.widget.TextView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[408,258][930,346]" /></node><node index="2" text="" resource-id="" class="android.widget.ImageView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[945,222][1002,279]" /></node><node index="1" text="" resource-id="" class="android.widget.LinearLayout" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[78,346][1002,2115]"><node index="0" text="Check soon" resource-id="" class="android.widget.TextView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[78,377][316,449]" /><node index="1" text="The car is usually safe to drive for now, but fuel use, emissions or performance may suffer. Get it checked in the next few weeks." resource-id="" class="android.widget.TextView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[78,449][1002,612]" /><node index="2" text="What it means" resource-id="" class="android.widget.TextView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[78,612][1002,704]" /><node index="3" text="The front oxygen sensor (before the catalytic converter), which the computer uses to set the fuel mixture, is reacting too slowly to changes in the exhaust. It's usually an ageing sensor." resource-id="" class="android.widget.TextView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[78,704][1002,913]" /><node index="4" text="You might notice" resource-id="" class="android.widget.TextView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[78,913][1002,1005]" /><node index="5" text="•  Higher fuel use&#10;•  Can lead to a catalytic converter code if ignored" resource-id="" class="android.widget.TextView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[78,1005][1002,1122]" /><node index="6" text="Common causes" resource-id="" class="android.widget.TextView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[78,1122][1002,1214]" /><node index="7" text="•  An old, worn-out oxygen sensor (common after 150,000 km)&#10;•  A sensor contaminated by oil burning or a coolant leak&#10;•  An exhaust leak near the sensor" resource-id="" class="android.widget.TextView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[78,1214][1002,1423]" /><node index="8" text="What to check" resource-id="" class="android.widget.TextView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[78,1423][1002,1515]" /><node index="9" text="1.  Check for exhaust leaks near the sensor&#10;2.  Check the engine isn't burning oil or coolant&#10;3.  Replace the sensor" resource-id="" class="android.widget.TextView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[78,1515][1002,1678]" /><node index="10" text="When it was set (freeze frame)" resource-id="" class="android.widget.TextView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[78,1678][1002,1770]" /><node index="11" text="Fuel system: Closed loop, using the oxygen sensors (normal)&#10;Engine RPM: 2,140 rpm&#10;Speed: 40 mph&#10;Coolant: 190 °F&#10;Engine load: 41%&#10;Short-term fuel trim (bank 1): +9.4%&#10;Long-term fuel trim (bank 1): +12.5%&#10;Manifold pressure: 46 kPa&#10;Intake air: 84 °F&#10;Throttle: 18%&#10;MAF airflow: 12.1 g/s" resource-id="" class="android.widget.TextView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[78,1770][1002,2115]" /></node></node></node></node></node></node><node index="1" text="" resource-id="com.obdr