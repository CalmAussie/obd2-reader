.widget.TextView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[78,449][1002,612]" drawing-order="2" hint="" /><node index="2" text="What it means" resource-id="" class="android.widget.TextView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[78,612][1002,704]" drawing-order="3" hint="" /><node index="3" text="The front oxygen sensor (before the catalytic converter), which the computer uses to set the fuel mixture, is reacting too slowly to changes in the exhaust. It's usually an ageing sensor." resource-id="" class="android.widget.TextView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[78,704][1002,913]" drawing-order="4" hint="" /><node index="4" text="You might notice" resource-id="" class="android.widget.TextView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[78,913][1002,1005]" drawing-order="5" hint="" /><node index="5" text="•  Higher fuel use&#10;•  Can lead to a catalytic converter code if ignored" resource-id="" class="android.widget.TextView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[78,1005][1002,1122]" drawing-order="6" hint="" /><node index="6" tex