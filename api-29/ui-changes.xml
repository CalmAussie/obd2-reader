nabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[52,1536][1028,1616]" /><node index="1" text="You're on the latest version (2.5.12). Here's what's in it:" resource-id="" class="android.widget.TextView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[52,1616][1028,1707]" /><node index="2" text="2.5.12  ·  20 November 2026" resource-id="" class="android.widget.TextView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[52,1707][1028,1823]" /><node index="3" text="• Drive routes. A wrong GPS position, like the far-away place a phone can report for a moment when GPS starts, is now left out. It no longer stretches the route on the drive card or the video overlay's map, or stops the trip summary from spotting that you drove the same route as last time.&#10;• Smoother sharing. The drive card and the video overlay now read a long drive in the background, so the app doesn't pause while they open, and say so if a long drive takes a moment." resource-id="" class="android.widget.TextView" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[52,1823][1028,2201]" /></node></node></node></node></node></node></node></node></node><node index="1" text="" resource-id="android:id/navigationBarBackground" class="android.view.View" package="com.obdreader.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" sc